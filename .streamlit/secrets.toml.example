# Copy this file to .streamlit/secrets.toml for local development.
# In production (Streamlit Community Cloud / Hugging Face Spaces), paste the
# equivalent TOML into the app's "Secrets" settings in the platform UI instead
# of committing a real secrets.toml.
#
# Generate a bcrypt password hash for a new recruiter with:
#   python -c "import streamlit_authenticator as stauth; print(stauth.Hasher(['the-password']).generate()[0])"
#
# Generate a random cookie signing key with:
#   python -c "import secrets; print(secrets.token_hex(32))"

HUGGINGFACE_HUB_API_TOKEN = "hf_replace_with_your_own_token"

[auth.cookie]
name = "cvgenius_auth"
key = "replace-with-a-long-random-per-deployment-secret"
expiry_days = 7

# One [auth.credentials.usernames.<username>] block per recruiter/admin account.
# role must be either "admin" or "recruiter".
[auth.credentials.usernames.admin]
email = "admin@example.com"
name = "Admin"
role = "admin"
password = "$2b$12$replace.with.a.bcrypt.hash.generated.above"

[auth.credentials.usernames.jdupont]
email = "j.dupont@example.com"
name = "Jean Dupont"
role = "recruiter"
password = "$2b$12$replace.with.a.bcrypt.hash.generated.above"

[auth.pre-authorized]
emails = []
